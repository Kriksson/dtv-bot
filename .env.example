# Obtain a fresh token from @BotFather. Never commit a real token.
BOT_TOKEN=
# Absolute path to the administrator ID file, one numeric Telegram ID per line.
ADMINS_FILE=/opt/dtv-bot/config/admins.txt
# SQLite database filename or absolute path.
DATABASE_PATH=dtv_bot.sqlite3
# Seconds for a fast-add session.
FAST_ADD_TIMEOUT_SECONDS=120
# Use an HTTP proxy from Russia when direct Telegram API access is unavailable.
TELEGRAM_PROXY=
WEBAPP_URL=https://188.120.245.3.sslip.io
WEBAPP_PORT=8080
